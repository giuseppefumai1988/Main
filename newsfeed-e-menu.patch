diff --git a/.github/workflows/newsfeed.yml b/.github/workflows/newsfeed.yml
new file mode 100644
index 0000000..ee26dae
--- /dev/null
+++ b/.github/workflows/newsfeed.yml
@@ -0,0 +1,45 @@
+name: Newsfeed testate infermieristiche
+
+# Raccoglie i titoli dai feed RSS di Nurse Times, Nurse24 e InfermieriAttivi
+# e aggiorna news-feed.json, che alimenta la barra rossa sotto l'hero della home.
+#
+# Perché serve: i browser non possono leggere quei feed direttamente (blocco CORS).
+# Raccogliendoli qui, il sito legge un file del proprio dominio: niente errori,
+# niente servizi di terze parti, nessun dato dei visitatori che esce dal sito.
+
+on:
+  schedule:
+    - cron: '17 */3 * * *'   # ogni tre ore
+  workflow_dispatch:          # e quando lo lanci a mano dalla scheda Actions
+
+permissions:
+  contents: write
+
+concurrency:
+  group: newsfeed
+  cancel-in-progress: false
+
+jobs:
+  aggiorna:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '20'
+
+      - name: Raccogli i titoli
+        run: node tools/build-newsfeed.mjs
+
+      - name: Pubblica se qualcosa è cambiato
+        run: |
+          if [ -n "$(git status --porcelain news-feed.json)" ]; then
+            git config user.name  "github-actions[bot]"
+            git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+            git add news-feed.json
+            git commit -m "Newsfeed: aggiornamento automatico dei titoli"
+            git push
+          else
+            echo "Nessuna novità da pubblicare."
+          fi
